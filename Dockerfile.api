# Donegal Bus Routes — FastAPI service
FROM python:3.11-slim

# ── System dependencies for geospatial packages ───────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgeos-dev \
    libproj-dev \
    proj-data \
    proj-bin \
    libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Install uv ─────────────────────────────────────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# ── Make the src layout visible to Python ─────────────────────────────────────
# pyproject.toml has no [build-system] table, so uv treats the project as
# virtual and never installs donegal_bus as a package. Setting PYTHONPATH
# directly is the reliable alternative for a src layout in Docker.
ENV PYTHONPATH=/app/src

# ── Install third-party dependencies (cached layer) ───────────────────────────
# Copying only the lock files first means this layer is only invalidated when
# dependencies change, not on every source edit. --no-install-project skips
# trying (and silently failing) to install the project package itself.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache --no-install-project

# ── Copy application source ───────────────────────────────────────────────────
COPY src/ ./src/
COPY main.py ./

# ── Runtime ────────────────────────────────────────────────────────────────────
# Data directories (graph/, testing/, data/) are mounted as read-only volumes
# by docker-compose at runtime; they are NOT baked into the image.

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["/app/.venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
