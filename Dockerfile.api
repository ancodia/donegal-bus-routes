# Donegal Bus Routes — FastAPI service
FROM python:3.11-slim

# ── System dependencies for geospatial packages ───────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgeos-dev \
    libproj-dev \
    proj-data \
    proj-bin \
    libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Install uv ─────────────────────────────────────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# ── Install dependencies (cached layer — only invalidated when lock changes) ───
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache

# ── Copy application source ────────────────────────────────────────────────────
COPY src/ ./src/
COPY main.py ./

# ── Runtime ────────────────────────────────────────────────────────────────────
# Data directories (graph/, testing/, data/) are mounted as read-only volumes
# by docker-compose at runtime; they are NOT baked into the image.

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["/app/.venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
